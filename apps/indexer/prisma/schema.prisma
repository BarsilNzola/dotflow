generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Just store Polkadot Hub chain info
model Chain {
  id          Int      @id @default(autoincrement())
  chainId     Int      @unique // Polkadot Hub chain ID
  name        String
  lastBlock   BigInt   @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Tokens on Polkadot Hub
model Token {
  id             String   @id @default(cuid())
  address        String   @unique // Token contract address on Polkadot Hub
  symbol         String
  name           String
  decimals       Int
  logoURI        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  swapsFrom      Swap[]   @relation("tokenIn")
  swapsTo        Swap[]   @relation("tokenOut")
}

// Swaps from your DotFlowRouter
model Swap {
  id              String   @id @default(cuid())
  swapId          String   @unique // bytes32 from contract
  userAddress     String
  tokenInAddress  String
  tokenOutAddress String
  amountIn        BigInt
  amountOut       BigInt?
  amountOutMin    BigInt
  recipient       String
  fee             BigInt?
  status          String   @default("PENDING") // PENDING, COMPLETED, FAILED, CANCELLED
  txHash          String   @unique
  blockNumber     BigInt
  blockTimestamp  DateTime
  createdAt       DateTime @default(now())
  
  tokenIn         Token    @relation("tokenIn", fields: [tokenInAddress], references: [address])
  tokenOut        Token    @relation("tokenOut", fields: [tokenOutAddress], references: [address])
  xcmMessage      XCMMessage?
  
  @@index([userAddress])
  @@index([swapId])
  @@index([txHash])
}

// XCM messages for cross-chain swaps
model XCMMessage {
  id                String    @id @default(cuid())
  messageId         String    @unique
  swapId            String    @unique
  destinationChain  String    // Parachain name or ID
  amount            BigInt
  status            String    @default("PREPARED") // PREPARED, EXECUTED, FAILED, CANCELLED, EXPIRED
  executedAt        DateTime?
  createdAt         DateTime  @default(now())
  
  swap              Swap      @relation(fields: [swapId], references: [swapId])
  
  @@index([messageId])
  @@index([status])
}

// Your deployed adapters
model Adapter {
  id              String   @id @default(cuid())
  address         String   @unique
  name            String
  type            String   // UNISWAP_V2, PARACHAIN, CUSTOM
  isActive        Boolean  @default(true)
  fee             Int      // in basis points
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Parachains you can bridge to
model Parachain {
  id              String   @id @default(cuid())
  parachainId     Int      @unique
  name            String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Sync state for indexer
model SyncState {
  id              String   @id @default(cuid())
  lastBlock       BigInt
  lastSync        DateTime @default(now())
  isSyncing       Boolean  @default(false)
}